#include "Config.h"

#define ENABLE_HIT_BRIDGE 1
#include "PathTracerVisibility.hlsli"
#include "PathPayload.hlsli"

using ActiveRayPayload = PathPayload;

// Primary rays use the upstream alpha test; ExcludeFromNEE only affects visibility rays.
// Opaque geometry never reaches this shader.
#ifndef RTXPT_VISIBILITY_ANY_HIT
[shader("anyhit")] void main(inout ActiveRayPayload                  Payload,
                             in BuiltInTriangleIntersectionAttributes Attributes) {
    if (!Bridge::AlphaTestImpl(Bridge::getSubInstanceData(), PrimitiveIndex(), Attributes.barycentrics))
        IgnoreHit();
}
#else
// TraceRay fallback shares the inline RayQuery candidate filter.
[shader("anyhit")] void VisibilityMain(inout ActiveRayPayload Payload,
                                      in BuiltInTriangleIntersectionAttributes Attributes)
{
    if (!Bridge::AlphaTestVisibilityRay(InstanceID(), GeometryIndex(), PrimitiveIndex(), Attributes.barycentrics))
        IgnoreHit();
}
#endif
