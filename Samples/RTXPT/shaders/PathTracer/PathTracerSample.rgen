#include "Config.h"

#ifndef RTXPT_ENABLE_LOW_DISCREPANCY_SAMPLER_FOR_BSDF
#    define RTXPT_ENABLE_LOW_DISCREPANCY_SAMPLER_FOR_BSDF 1
#endif

#include "Utils/StatelessSampleGenerators.hlsli"
#include "PathTracer.hlsli"

#if PATH_TRACER_MODE == PATH_TRACER_MODE_FILL_DENOISING_LAYERS || defined(__INTELLISENSE__)
float2 FirstHitFromVBuffer(inout PathState path,
                           const uint basePlaneIndex,
                           const PathTracer::WorkingContext workingContext)
{
    const uint2 pixelPos = path.GetPixelPos();
    float2      tMinMax  = float2(0.0, kMaxRayTravel);

    DenoisingLayer sp             = workingContext.DenoisingLayers.LoadDenoisingLayer(pixelPos, basePlaneIndex);
    uint        stableBranchID = workingContext.DenoisingLayers.GetBranchID(pixelPos, basePlaneIndex);

    float sceneLength     = sp.SceneLength;
    float lastRayTCurrent = sp.LastRayTCurrent;
    uint  vertexIndex     = sp.VertexIndexAndRoughness >> 16;

    float3 thp;
    float3 dummy;
    UnpackTwoFp32ToFp16(sp.PackedThpAndMVs, thp, dummy);

    bool isMiss = false;
    if (!isfinite(sceneLength))
    {
        sceneLength = kMaxRayTravel;
        isMiss      = true;
    }
    else
    {
        tMinMax.x = lastRayTCurrent * 0.99;
        tMinMax.y = lastRayTCurrent * 1.01;
        sceneLength -= lastRayTCurrent;
    }

    path.setVertexIndex(vertexIndex - 1);
    path.SetDir(sp.RayDir);
    path.SetOrigin(sp.RayOrigin);
    path.setFlag(PathFlags::denoisingLayerOnPlane, true);
    path.setFlag(PathFlags::denoisingLayerOnBranch, true);
    path.setDenoisingLayerIndex(basePlaneIndex);
    path.stableBranchID = stableBranchID;
    path.SetThp(thp);
    path.SetL(float4(0.0, 0.0, 0.0, 0.0));

    const uint dominantSPIndex = workingContext.DenoisingLayers.LoadDominantIndex(pixelPos);
    path.setFlag(PathFlags::denoisingLayerOnDominantBranch, dominantSPIndex == basePlaneIndex);
    path.setCounter(PackedCounters::BouncesFromDenoisingLayer, 0);

    if (PathTracer::HasFinishedSurfaceBounces(path.getVertexIndex() + 1,
                                              path.getCounter(PackedCounters::DiffuseBounces)))
        path.setTerminateAtNextBounce();

    PathTracer::UpdatePathTravelledLengthOnly(path, sceneLength);

    if (isMiss)
        PathTracer::HandleMiss(path, path.GetOrigin(), path.GetDir(), sceneLength, workingContext);

    return tMinMax;
}
#endif

void postProcessHit(inout PathState path, const PathTracer::WorkingContext workingContext)
{
#if PATH_TRACER_MODE == PATH_TRACER_MODE_BUILD_DENOISING_LAYERS
    int         nextPlaneToExplore;
    const uint2 pixelPos = path.GetPixelPos();
    if (!path.isActive() &&
        (nextPlaneToExplore = workingContext.DenoisingLayers.FindNextToExplore(pixelPos, path.getDenoisingLayerIndex() + 1)) != -1)
    {
        PathPayload payload;
        workingContext.DenoisingLayers.ExplorationStart(pixelPos, nextPlaneToExplore, payload.packed);
        path = PathPayload::unpack(payload);
    }
#endif
}

void nextHit(inout PathState path, inout float2 tMinMax, const PathTracer::WorkingContext workingContext)
{
    RayDesc ray = path.getScatterRay().toRayDesc();
    ray.TMin    = tMinMax.x;
    ray.TMax    = tMinMax.y;

#if USE_DX_HIT_OBJECT_EXTENSION
    RayQuery<RAY_FLAG_NONE> rayQuery;
    Bridge::traceScatterRay(ray, rayQuery);
    if (rayQuery.CommittedStatus() != COMMITTED_TRIANGLE_HIT)
    {
        PathTracer::HandleMiss(path, ray.Origin, ray.Direction, kMaxRayTravel, workingContext);
        return;
    }
    dx::HitObject hit = Bridge::makeScatterHit(rayQuery);
#if USE_DX_MAYBE_REORDER_THREADS && PATH_TRACER_MODE != PATH_TRACER_MODE_BUILD_DENOISING_LAYERS
    if (path.hasFlag(PathFlags::enableThreadReorder))
        dx::MaybeReorderThread(hit, uint(path.isTerminatingAtNextBounce()), 1);
#endif
    PathPayload payload = PathPayload::pack(path);
    dx::HitObject::Invoke(hit, payload);
#else
    PathPayload payload = PathPayload::pack(path);
    TraceRay(t_SceneBVH,
             RAY_FLAG_NONE,
             0xFF,
             RTXPT_PRIMARY_RAY_INDEX,
             RTXPT_HIT_GROUP_STRIDE,
             RTXPT_PRIMARY_RAY_INDEX,
             ray,
             payload);
#endif
    path = PathPayload::unpack(payload);

    tMinMax = float2(0.0, kMaxRayTravel);
}

void ValidateNaNs(inout PathState path, PathTracer::WorkingContext workingContext)
{
    bool somethingWrong = false;
#if PATH_TRACER_MODE != PATH_TRACER_MODE_BUILD_DENOISING_LAYERS
    float4 L = path.GetL();
    somethingWrong |= any(isnan(L)) || !all(isfinite(L));
#endif
    somethingWrong |= any(isnan(path.GetThp())) || !all(isfinite(path.GetThp()));
    if (somethingWrong)
    {
#if PATH_TRACER_MODE != PATH_TRACER_MODE_BUILD_DENOISING_LAYERS
        path.SetL(float4(0.0, 0.0, 0.0, 0.0));
#endif
        path.SetThp(float3(0.0, 0.0, 0.0));
    }
}

[shader("raygeneration")]
void main()
{
    uint2 pixelPos = DispatchRaysIndex().xy;
#if RTXPT_SHARC_TRAIN
    uint scale = g_Sharc.DownscaleFactor;
    uint random = Hash32Combine(Hash32(pixelPos.x + pixelPos.y * DispatchRaysDimensions().x), Bridge::getSampleIndex());
    pixelPos = pixelPos * scale + uint2(random % scale, (random / scale) % scale);
    if (any(pixelPos >= g_Const.ptConsts.camera.ViewportSize)) return;
    u_SharcPathState.Store(PathTracer::SharcPathStateOffset(), 0);
#endif
    const Ray primaryRay = Bridge::computeCameraRay(pixelPos);
    PathState path = PathTracer::EmptyPathInitialize(pixelPos,
                                                     g_Const.ptConsts.camera.PixelConeSpreadAngle);
    PathTracer::SetupPathPrimaryRay(path, primaryRay);

    PathTracer::WorkingContext workingContext = GetWorkingContext();
#if !RTXPT_SHARC_TRAIN
    PathTracer::StartPixel(path, workingContext);
#endif

#if PATH_TRACER_MODE == PATH_TRACER_MODE_FILL_DENOISING_LAYERS
    float2 tMinMax = FirstHitFromVBuffer(path, 0u, workingContext);
#elif PATH_TRACER_MODE == PATH_TRACER_MODE_REFERENCE
    float2 tMinMax = float2(primaryRay.tMin, primaryRay.tMax);
#else
    float2 tMinMax = float2(0.0, kMaxRayTravel);
#endif

#if PATH_TRACER_MODE == PATH_TRACER_MODE_REFERENCE
    const uint referenceMaxLoopIterations =
        max(2u,
            max(workingContext.PtConsts.bounceCount, 1u) +
            PathTracer::GetMaxRejectedDielectricHits() +
            2u);
    uint referenceLoopIterations = 0u;
#endif

    while (path.isActive())
    {
#if PATH_TRACER_MODE == PATH_TRACER_MODE_REFERENCE
        if (referenceLoopIterations++ >= referenceMaxLoopIterations)
        {
            path.terminate();
            break;
        }
#endif

        nextHit(path, tMinMax, workingContext);
        postProcessHit(path, workingContext);
    }

    ValidateNaNs(path, workingContext);
#if !RTXPT_SHARC_TRAIN
    PathTracer::CommitPixel(path, workingContext);
#endif
}
